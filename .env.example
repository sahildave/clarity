# Server-only AI Gateway authentication for local development.
AI_GATEWAY_API_KEY=
# Optional. Defaults to google/gemini-3.5-flash-lite
AI_COACH_MODEL=google/gemini-3.5-flash-lite
APP_VARIANT=development # LOCAL ONLY
EXPO_PUBLIC_AZURE_SPEECH_KEY=
EXPO_PUBLIC_AZURE_SPEECH_REGION=
# Set to 1 to send EAS Observe metrics from a debug build. Off by default, so
# dev-build noise stays out of the dashboard. No effect on release builds.
EXPO_PUBLIC_OBSERVE_IN_DEV=
HUGEICONS_TOKEN=
# RevenueCat. Platform keys are REQUIRED for release builds: without one,
# purchases stay disabled rather than falling back to a test key, which
# RevenueCat crashes release builds for on purpose. Copy them from
# app.revenuecat.com under Project Settings > API keys (the public app-specific
# keys, appl_… and goog_…, never a secret key).
EXPO_PUBLIC_RC_IOS_API_KEY=
EXPO_PUBLIC_RC_ANDROID_API_KEY=
# Optional. Overrides the built-in Test Store key that dev builds use by default
# so purchases work on a simulator with no App Store Connect products.
EXPO_PUBLIC_RC_TEST_API_KEY=
# Set to 1 to make a DEV build use the platform key above instead of the Test
# Store, for testing real App Store / Play sandbox receipts end to end.
EXPO_PUBLIC_RC_USE_STORE=
# Clerk. The publishable key is public by design (pk_test_ for the development
# instance, pk_live_ for production). Set per EAS environment, then `eas env:pull`.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Native Google sign-in. One Web client (also entered in the Clerk Google social
# connection as custom credentials) and one iOS client PER bundle id variant, so
# these two iOS values differ between the development, preview, and production
# environments. The URL scheme is the iOS client id reversed
# (com.googleusercontent.apps.…); the config plugin writes it into Info.plist and
# silently skips it when unset, so a missing value fails at sign-in, not at build.
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=
# Optional test account on the Clerk DEVELOPMENT instance. Use a
# `+clerk_test` email so the simulator QA build can sign in with Clerk's fixed
# test OTP and no bundled password. Email verification code must be enabled as
# a sign-in strategy on that instance. The email is public by design and may
# live in the EAS development environment. The password is LOCAL ONLY and only
# enables the convenience button in a debug build; never put it in EAS.
EXPO_PUBLIC_DEV_SIGNIN_EMAIL=
EXPO_PUBLIC_DEV_SIGNIN_PASSWORD=
# Set by the `simulator` build profile, not in shared EAS environments. It
# exposes QA-only routes/sign-in and is always paired with mocked speech.
EXPO_PUBLIC_AUTOMATION=
# Use deterministic passage and freestyle sessions instead of native audio.
EXPO_PUBLIC_MOCK_PRACTICE=
# Expose the deterministic history seed deep link.
EXPO_PUBLIC_SEED_HOOKS=
# Convex. `bunx convex dev` writes all three on first run. EXPO_PUBLIC_CONVEX_URL
# must also live in every EAS environment (dev, preview, production), because
# `eas env:pull` rewrites this file in full and drops anything not mirrored there.
# CONVEX_DEPLOYMENT is a local developer value and stays out of EAS.
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=
# NOT read from this file. `convex/auth.config.ts` runs on the Convex backend, so
# the Clerk Frontend API URL is set per deployment with
#   bunx convex env set CLERK_FRONTEND_API_URL '<url>'          (dev)
#   bunx convex env set --prod CLERK_FRONTEND_API_URL '<url>'   (prod)
# Dev uses the *.clerk.accounts.dev URL; prod uses https://clerk.clarityspeech.app.
# The Convex integration must be activated on EACH Clerk instance.
